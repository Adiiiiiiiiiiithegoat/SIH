# Large data / archives — never commit
MEDIC.tar.gz
*.opdownload
medic/
population/data/*.tif
population/data/*.tiff
population/.venv/

# Generated graphs / databases
*.graphml
*.db
*.sqlite3

# Python
__pycache__/
*.pyc
.venv/
venv/
cache/

# App runtime
app/data/uploads/
app/data/reports.db

# The backend's own inputs. These four ARE committed: without them a fresh
# clone cannot start the API at all, and together they are 5.7 MB. Everything
# else matching the rules above stays excluded -- source rasters, the national
# WorldPop file, and any regenerated graph elsewhere in the tree.
!app/data/surathkal_buffered.graphml
!app/data/population_100m.tif
!app/data/settlements.csv
!app/data/reference.json

# Reports / scratch
report*.txt

# Secrets
.env

# OS
.DS_Store

# Local tunnel binary (demo deploy, not project code)
.bin/
